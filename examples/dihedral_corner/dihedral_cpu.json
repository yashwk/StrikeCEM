{
  "scem_schema_version": "1.0",
  "model": {
    "path": "dihedral_90deg.obj",
    "units": "m",
    "mesh_repair": "report"
  },
  "frequency": {
    "frequency_hz": 10000000000.0
  },
  "physics": {
    "monostatic": true,
    "polarization_basis": "linear",
    "incident_amplitude": 1.0,
    "phase_reference": [0.0, 0.0, 0.0]
  },
  "angles": {
    "azimuth": {
      "start": 180.0,
      "stop": 180.0,
      "step": 1.0
    },
    "elevation": {
      "start": -90.0,
      "stop": 0.0,
      "step": 1.0
    }
  },
  "polarization": [
    "HH",
    "VV"
  ],
  "solver": {
    "type": "PO",
    "precision": "float64",
    "rcs_units": "dBsm",
    "shadowing": true,
    "po_options": {
      "shadowing": true,
      "max_bounces": 2
    }
  },
  "execution": {
    "accelerator": "cuda"
  },
  "output": {
    "format": "hdf5",
    "path": "examples/dihedral_corner/dihedral_cpu.h5"
  }
}
