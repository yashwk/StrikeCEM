{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yashwk.github.io/strikecem/schemas/config.schema.json",
  "title": "StrikeCEM v1 configuration",
  "description": "Stable v1 contract: STL/OBJ input, monostatic PO, regular or explicit angle sampling, and fixed-field CSV/HDF5 output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scem_schema_version", "model", "frequency", "angles", "solver", "output"],
  "properties": {
    "scem_schema_version": {"const": "1.0"},
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["design_id", "revision"],
          "properties": {
            "design_id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "export_id": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "enum": ["mesh"], "default": "mesh"},
        "units": {"type": "string", "enum": ["m", "mm", "in"], "default": "m"},
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "translate": {"$ref": "#/definitions/vector3"},
            "rotate_euler_deg": {"$ref": "#/definitions/vector3"},
            "scale": {"type": "number", "exclusiveMinimum": 0, "default": 1.0}
          }
        },
        "mesh_repair": {"type": "string", "enum": ["off", "report", "repair"], "default": "report"}
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["frequency_hz"], "not": {"required": ["sweep"]}},
        {"required": ["sweep"], "not": {"required": ["frequency_hz"]}}
      ],
      "properties": {
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "sweep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "stop", "step"],
          "properties": {
            "start": {"type": "number", "exclusiveMinimum": 0},
            "stop": {"type": "number", "exclusiveMinimum": 0},
            "step": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "medium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epsilon_r": {"type": "number", "exclusiveMinimum": 0, "default": 1.0},
            "mu_r": {"type": "number", "exclusiveMinimum": 0, "default": 1.0},
            "sigma": {"type": "number", "minimum": 0, "default": 0.0}
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monostatic": {"const": true, "default": true},
        "polarization_basis": {"const": "linear", "default": "linear", "description": "The v1 incidence basis is fixed to linear; circular output channels are selected through polarization."},
        "incident_amplitude": {"type": "number", "exclusiveMinimum": 0, "default": 1.0}
      }
    },
    "angles": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["azimuth", "elevation"], "not": {"required": ["list"]}},
        {"required": ["list"], "not": {"anyOf": [{"required": ["azimuth"]}, {"required": ["elevation"]}]}}
      ],
      "properties": {
        "azimuth": {"$ref": "#/definitions/angle_axis_azimuth"},
        "elevation": {"$ref": "#/definitions/angle_axis_elevation"},
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [{"type": "number"}, {"type": "number"}]
          }
        },
        "deduplicate_periodic_endpoints": {"const": true, "default": true, "description": "Periodic endpoints and duplicate directions are always deduplicated in v1."}
      }
    },
    "polarization": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["HH", "VV", "HV", "VH", "RHCP", "LHCP"]},
      "default": ["HH", "VV"]
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "PO", "default": "PO"},
        "precision": {"type": "string", "enum": ["float32", "float64"], "default": "float64"},
        "rcs_units": {"const": "dBsm", "default": "dBsm", "description": "Compatibility field; v1 output always contains both square metres and dBsm."},
        "po_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "edge_correction": {"type": "string", "enum": ["none", "fringe"], "default": "none"},
            "illumination_model": {"const": "hard", "default": "hard"},
            "curvature_correction": {"const": false, "default": false},
            "shadowing": {"type": "boolean", "default": false},
            "max_bounces": {"type": "integer", "minimum": 1, "maximum": 3, "default": 1}
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "input", "default": "input"},
        "validate_orientation": {"const": true, "default": true, "description": "Winding diagnostics are always computed and reported in v1."},
        "max_aspect_ratio": {"type": "number", "exclusiveMinimum": 1, "default": 20.0},
        "cache_dir": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {"type": "integer", "minimum": 1, "default": 1},
        "batch_samples": {"const": 4096, "default": 4096, "description": "Reserved; v1 uses an internal solver batch size."},
        "max_memory_mb": {"type": "number", "exclusiveMinimum": 0, "default": 16384},
        "deterministic": {"const": true, "default": true},
        "accelerator": {"type": "string", "enum": ["cpu", "cuda"], "default": "cpu"},
        "cuda_device_id": {"type": "integer", "minimum": 0, "default": 0},
        "cuda_batch_units": {"type": "integer", "minimum": 0, "default": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "enum": ["csv", "hdf5"], "default": "hdf5"},
        "precision": {"type": "integer", "minimum": 1, "maximum": 17, "default": 6},
        "compression": {"const": false, "default": false, "description": "Compression is not supported in v1."},
        "include_metadata": {"const": true, "default": true, "description": "Provenance metadata is always written in v1."}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_every_n_samples": {"type": "integer", "minimum": 1, "default": 1000},
        "resume_from_checkpoint": {"type": "string", "minLength": 1},
        "log_level": {"const": "info", "default": "info", "description": "Reserved; v1 currently has no configurable log filtering."}
      }
    }
  },
  "definitions": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "angle_axis_azimuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "step"],
      "properties": {
        "start": {"type": "number", "minimum": 0, "maximum": 360},
        "stop": {"type": "number", "minimum": 0, "maximum": 360},
        "step": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "angle_axis_elevation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "step"],
      "properties": {
        "start": {"type": "number", "minimum": -90, "maximum": 90},
        "stop": {"type": "number", "minimum": -90, "maximum": 90},
        "step": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
